# ── AI / LLM ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Daily usability layer ────────────────────────────────────────────────────
# Minimum composite score (0-100) for a stock to appear in --morning picks
MIN_SCORE_THRESHOLD=60

# Holding period in days; rebalance alert fires when today >= last_rebalance + this
HOLDING_PERIOD_DAYS=25

# ── Signal weight overrides (optional, defaults shown) ─────────────────────
# All weights are re-normalised to sum to 1.0 automatically.
# MOMENTUM_WEIGHT=0.30
# FUNDAMENTAL_WEIGHT=0.25
# INSIDER_WEIGHT=0.25
# SENTIMENT_WEIGHT=0.20
# PAIRS_WEIGHT=0.15

# ── SEC EDGAR (insider trades + point-in-time fundamentals) ─────────────────
# SEC asks API clients to identify themselves: "Name email". The built-in
# placeholder works but may be throttled. Use your own.
# SEC_USER_AGENT=Your Name you@example.com

# ── Forward-test log ────────────────────────────────────────────────────────
# Where the daily tamper-evident pick log is written (commit this directory!).
# FORWARD_LOG_DIR=forward_log
